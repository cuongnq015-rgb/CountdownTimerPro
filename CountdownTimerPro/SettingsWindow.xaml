<Window x:Class="CountdownTimerPro.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Width="500"
        Height="560"

        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"

        WindowStyle="None"
        AllowsTransparency="True"

        Background="Transparent">

    <Window.Resources>

        <SolidColorBrush x:Key="WindowBrush" Color="#1E222B"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#2B313D"/>
        <SolidColorBrush x:Key="BorderBrushDark" Color="#464E60"/>

        <!-- Button -->

        <Style TargetType="Button">

            <Setter Property="Height" Value="42"/>

            <Setter Property="FontSize" Value="15"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Margin" Value="5"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- TextBox -->

        <Style TargetType="TextBox">

            <Setter Property="Height" Value="36"/>

            <Setter Property="FontSize" Value="15"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="Background" Value="#3B4252"/>

            <Setter Property="BorderBrush" Value="#555"/>

            <Setter Property="Padding" Value="10,4"/>

            <Setter Property="Margin" Value="0,5,0,15"/>

        </Style>

        <!-- CheckBox -->

        <Style TargetType="CheckBox">

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="FontSize" Value="15"/>

            <Setter Property="Margin" Value="0,10"/>

        </Style>

    </Window.Resources>

    <Border
        Background="{StaticResource WindowBrush}"
        BorderBrush="{StaticResource BorderBrushDark}"
        BorderThickness="2"
        CornerRadius="18">

        <Grid Margin="20">

            <Grid.RowDefinitions>

                <RowDefinition Height="60"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="70"/>

            </Grid.RowDefinitions>

            <!-- HEADER -->

            <Border
                Background="{StaticResource PanelBrush}"
                CornerRadius="12"
                Padding="15">

                <StackPanel Orientation="Horizontal">

                    <TextBlock
                        Text="⚙"
                        FontSize="25"
                        Margin="0,0,12,0"/>

                    <StackPanel>

                        <TextBlock
                            Text="Settings"
                            Foreground="White"
                            FontSize="22"
                            FontWeight="Bold"/>

                        <TextBlock
                            Text="Countdown Timer Pro"
                            Foreground="#AAB3C2"
                            FontSize="13"/>

                    </StackPanel>

                </StackPanel>

            </Border>

            <!-- BODY -->

            <Border
                Grid.Row="1"
                Margin="0,18,0,18"
                Background="{StaticResource PanelBrush}"
                CornerRadius="12"
                Padding="18">

                <StackPanel>

                    <TextBlock
                        Text="Minutes"
                        Foreground="#C8D0DD"
                        FontWeight="Bold"/>

                    <TextBox
                        x:Name="txtMinute"/>

                    <TextBlock
                        Text="Seconds"
                        Foreground="#C8D0DD"
                        FontWeight="Bold"/>

                    <TextBox
                        x:Name="txtSecond"/>

                    <Separator Margin="0,10"/>

                    <CheckBox
                        x:Name="chkTopMost"
                        Content="Always on Top"/>

                    <CheckBox
                        x:Name="chkBeep"
                        Content="Enable Beep"/>

                    <CheckBox
                        x:Name="chkBlink"
                        Content="Blink in last 10 seconds"/>

                    <CheckBox
                        x:Name="chkOvertime"
                        Content="Allow Overtime"/>

                    <CheckBox
                        x:Name="chkFullScreen"
                        Content="Full Screen Mode"/>

                </StackPanel>

            </Border>

            <!-- FOOTER -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition/>

                    <ColumnDefinition Width="130"/>

                    <ColumnDefinition Width="130"/>

                </Grid.ColumnDefinitions>

                <Button
                    x:Name="btnCancel"
                    Grid.Column="1"
                    Content="Cancel"
                    Background="#E53935"
                    Click="btnCancel_Click"/>

                <Button
                    x:Name="btnSave"
                    Grid.Column="2"
                    Content="Save"
                    Background="#00C853"
                    Click="btnSave_Click"/>

            </Grid>

        </Grid>

    </Border>

</Window>