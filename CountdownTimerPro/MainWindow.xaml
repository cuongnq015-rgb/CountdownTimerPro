<Window x:Class="CountdownTimerPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Countdown Timer Pro"

        Width="760"
        Height="560"

        MinWidth="700"
        MinHeight="520"

        WindowStartupLocation="CenterScreen"

        ResizeMode="CanResize"

        WindowStyle="None"

        AllowsTransparency="True"

        Background="Transparent"

        Topmost="True"

        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>

        <!-- Màu -->
        <SolidColorBrush x:Key="WindowBrush" Color="#1E222B"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#2A2F3A"/>
        <SolidColorBrush x:Key="BorderBrushDark" Color="#444B5A"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00C853"/>

        <!-- Button Style -->
        <Style TargetType="Button">

            <Setter Property="Height" Value="48"/>

            <Setter Property="MinWidth" Value="120"/>

            <Setter Property="Margin" Value="6"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="FontSize" Value="15"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Background" Value="#3B4252"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            CornerRadius="10"
                            Background="{TemplateBinding Background}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background"
                            Value="#4C566A"/>

                </Trigger>

                <Trigger Property="IsPressed" Value="True">

                    <Setter Property="Background"
                            Value="#5E81AC"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBox">

            <Setter Property="Height" Value="40"/>

            <Setter Property="FontSize" Value="15"/>

            <Setter Property="Foreground" Value="Black"/>

            <Setter Property="Background" Value="White"/>

            <Setter Property="BorderBrush" Value="#555"/>

            <Setter Property="Margin" Value="6"/>

        </Style>

    </Window.Resources>

    <Border
        CornerRadius="18"
        Background="{StaticResource WindowBrush}"
        BorderBrush="{StaticResource BorderBrushDark}"
        BorderThickness="2">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="56"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="125"/>

            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->

            <Border
                Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                CornerRadius="18,18,0,0">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="18,0">

                        <TextBlock
                            Text="⏳"
                            FontSize="24"
                            Margin="0,0,10,0"/>

                        <TextBlock
                            Text="Countdown Timer Pro"
                            Foreground="White"
                            FontSize="22"
                            FontWeight="Bold"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">

                        <Button
                            x:Name="btnMini"
                            Width="38"
                            Content="—"
                            Click="btnMini_Click"/>

                        <Button
                            x:Name="btnClose"
                            Width="38"
                            Background="#C62828"
                            Content="✕"
                            Click="btnClose_Click"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- ========= PHẦN BẮT ĐẦU TỪ ĐÂY (PHẦN B) ========= -->
            <!-- ================= CENTER ================= -->

            <Grid Grid.Row="1">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <!-- Tiêu đề chế độ -->

                <TextBlock
                    Grid.Row="0"
                    x:Name="txtModeTitle"
                    Text="COUNTDOWN"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0"
                    FontFamily="Segoe UI"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="#F8FAFC">

                    <TextBlock.Effect>
                        <DropShadowEffect
                            BlurRadius="8"
                            ShadowDepth="0"
                            Color="#00E676"
                            Opacity="0.5"/>
                    </TextBlock.Effect>

                </TextBlock>

                <!-- Đồng hồ -->

                <TextBlock
                    Grid.Row="1"
                    x:Name="txtTime"
                    Text="05:00"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="92"
                    FontWeight="Bold"
                    Foreground="#00E676"/>

                <!-- Thanh tiến trình -->

                <StackPanel
                    Grid.Row="2"
                    Margin="70,0,70,0">
                    <ProgressBar
                        x:Name="progress"
                        Height="18"
                        Minimum="0"
                        Maximum="100"
                        Value="100"
                        BorderThickness="0"
                        Background="#3A4150"
                        Foreground="#00E676"/>

                </StackPanel>

                <!-- Phần trăm -->

                <TextBlock
                    Grid.Row="1"
                    x:Name="txtPercent"
                    Text="100%"
                    Margin="351,214,0,10"
                    HorizontalAlignment="Left"
                    Foreground="#BFC7D5"
                    FontSize="15"
                    FontWeight="SemiBold" Grid.RowSpan="2"/>

                <!-- Trạng thái -->

                <Border
                    Grid.Row="3"
                    HorizontalAlignment="Left"
                    Margin="319,17,0,19"
                    Padding="16,6"
                    Background="#2D3442"
                    CornerRadius="12" Grid.RowSpan="2">

                    <StackPanel
                        Orientation="Horizontal">

                        <Ellipse
                            Width="10"
                            Height="8"
                            Margin="0,0,8,0"
                            Fill="#00E676"/>

                        <TextBlock
                            x:Name="txtStatus"
                            Text="READY"
                            Foreground="#00E676"
                            FontSize="15"
                            FontWeight="Bold"/>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- ================= END CENTER ================= -->
            <!-- ================= FOOTER ================= -->

            <Border
                Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                CornerRadius="0,0,18,18">

                <Grid Margin="20,12">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="180"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <!-- Mode -->

                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Margin="0,6,15,6">

                        <TextBlock
                            Text="⚙ MODE"
                            Foreground="#00E676"
                            FontSize="15"
                            FontWeight="Bold"
                            Margin="4,0,0,8"/>

                        <ComboBox
                            x:Name="cmbMode"
                            Width="160"
                            SelectionChanged="cmbMode_SelectionChanged">

                            <ComboBoxItem IsSelected="True">
                                Countdown
                            </ComboBoxItem>

                            <ComboBoxItem>
                                Stopwatch
                            </ComboBoxItem>

                        </ComboBox>

                    </StackPanel>

                    <!-- Buttons -->

                    <UniformGrid
                        Grid.Column="1"
                        Columns="4"
                        Rows="1"
                        VerticalAlignment="Center"
                        Margin="15,6,0,6" >

                        <Button
                            x:Name="btnStart"
                            Content="▶ START"
                            Background="#2E7D32"
                            Click="btnStart_Click"/>

                        <Button
                            x:Name="btnStop"
                            Content="■ STOP"
                            Background="#EF6C00"
                            Click="btnStop_Click"/>

                        <Button
                            x:Name="btnReset"
                            Content="↺ RESET"
                            Background="#1565C0"
                            Click="btnReset_Click"/>

                        <Button
                            x:Name="btnSetting"
                            Content="⚙ SETTINGS"
                            Background="#6A1B9A"
                            Click="btnSetting_Click"/>

                    </UniformGrid>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>